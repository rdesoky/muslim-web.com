ExpiresByType text/html "access plus 90 day"
ExpiresByType text/plain "access plus 90 day"
ExpiresByType text/xml "access plus 90 day"
ExpiresByType text/css "access plus 90 day"
ExpiresByType application/x-javascript "access plus 90 day"
